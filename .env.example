# Copy to .env and fill in. Never commit .env.
# Local default (no setup needed):
KAVRELLE_DATABASE_URL=sqlite:///kavrelle.db
# PostgreSQL (pgAdmin4):
# KAVRELLE_DATABASE_URL=postgresql+psycopg://kavrelle:YOUR_PASSWORD@localhost:5432/kavrelle
# Optional: run the tests on PostgreSQL too (this database is wiped by the tests):
# KAVRELLE_TEST_POSTGRES_URL=postgresql+psycopg://kavrelle:YOUR_PASSWORD@localhost:5432/kavrelle_test
